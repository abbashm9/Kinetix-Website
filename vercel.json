{
  "headers": [
    {
      "source": "/ar-demo/model-viewer.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ar-demo/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/#services",
      "permanent": true
    }
  ]
}